<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.base.biz.store.infrastructure.dao.StoreCategoryDAO">

    <resultMap id="BaseResultMap" type="com.newzkl.platform.base.biz.store.infrastructure.entity.StoreCategoryDO">
        <!--@Table store_category-->
        <result property="id" column="id" jdbcType="INTEGER"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="logo" column="logo" jdbcType="VARCHAR"/>
        <result property="index" column="index" jdbcType="INTEGER"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <sql id="Base_Column_List">
       id,
       name,
       logo,
       index,
       create_time,
       update_time

    </sql>

    <sql id="querySQL">
            <if test="id != null ">
                and id = #{query.id}
            </if>
            <if test="name != null  and query.name != ''">
                and name = #{query.name}
            </if>
            <if test="logo != null  and query.logo != ''">
                and logo = #{query.logo}
            </if>
            <if test="index != null ">
                and index = #{query.index}
            </if>
            <if test="createTime != null ">
                and create_time = #{query.createTime}
            </if>
            <if test="updateTime != null ">
                and update_time = #{query.updateTime}
            </if>
    </sql>

    <!-- 防止空查询 要使用<where>标签，否则当无条件时，or清除不了导致语法错误。 -->
    <sql id="preventEmptyQuerySql">
        <include refid="querySQL"/>
        or 1 = 0
    </sql>

</mapper>

