<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.newzkl.platform.Base</groupId>
        <artifactId>biz-sys</artifactId>
        <version>${base.revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>biz-sys-action</artifactId>
    <packaging>jar</packaging>
    <name>biz-sys-action</name>
    <dependencies>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>biz-sys-application</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>biz-sys-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>ddd-action</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>core-utils</artifactId>
        </dependency>
        <!-- 迁移补充: 验证码/发送频次缓存 RedisUtil (core-redis) -->
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>core-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>core-office</artifactId>
        </dependency>
        <!-- 迁移补充: CommonController#exportExcelError 直写 HttpServletResponse;
             ddd-action / core-utils 的 servlet-api 为 provided 不传递 -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
        </dependency>
        <!-- 迁移补充: CommonController#generateQrCode 走 hutool QrCodeUtil, 其底层二维码渲染依赖 zxing;
             hutool 将 zxing 声明为 optional 不传递, 故显式引入。版本由根 pom dependencyManagement 统一管理 -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.huaweicloud.sdk</groupId>
            <artifactId>huaweicloud-sdk-ocr</artifactId>
        </dependency>
    </dependencies>
</project>
