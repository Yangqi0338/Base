<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 迁移自 new-scm/scm-user DealerDAO.xml, 三个 wrapper 驱动语句原样套用 -->
<mapper namespace="com.newzkl.platform.base.biz.account.infrastructure.dao.DealerDAO">

    <select id="selectCountByCondition" resultType="java.lang.Long">
        select count(1)
        from dealer
        <where>
            ${ew.sqlSegment}
        </where>
    </select>

    <select id="selectListByCondition" resultType="java.lang.Long">
        select id
        from dealer
        <where>
            ${ew.sqlSegment}
        </where>
    </select>

    <!-- Base 返回 DealerOutRes, service_fee/invite_channel_number 等列 Base 已无, 对应字段落 null -->
    <select id="selectList" resultType="com.newzkl.platform.base.biz.account.model.res.DealerOutRes">
        select
        *
        from dealer
        ${ew.customSqlSegment}
    </select>

</mapper>
