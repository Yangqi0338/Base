<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 迁移自 new-scm/scm-user AccountDAO.xml(实际目录 mapper/ 非 daos/)
     适配: realname -> real_name; 删 Base AccountDO 已下线列(erole_id_list/name_auth_info/account_ext_v_o);
           源 accountByPidAndUserName/selectByUserAccount 的 username/userAccount jdbcType=BIGINT 为源侧笔误, 改 VARCHAR -->
<mapper namespace="com.newzkl.platform.base.biz.account.infrastructure.dao.AccountDAO">

    <!-- pageAccountDO/countAccountDO 共享条件, 字段按 Base AccountQuery 实有展开 -->
    <sql id="pageWhere">
        <if test="query.id != null">
            and t.`id` = #{query.id}
        </if>
        <if test="query.idList != null and query.idList.size() > 0">
            and t.`id` in
            <foreach collection="query.idList" item="item" separator="," close=")" open="(">
                #{item}
            </foreach>
        </if>
        <if test="query.mainAccountId != null">
            and t.`main_account_id` = #{query.mainAccountId}
        </if>
        <if test="query.pid != null">
            and t.`pid` = #{query.pid}
        </if>
        <if test="query.nickname != null and query.nickname.trim() != ''">
            and t.`nickname` like CONCAT('%', #{query.nickname},'%')
        </if>
        <if test="query.username != null and query.username.trim() != ''">
            and t.`username` like CONCAT('%', #{query.username},'%')
        </if>
        <if test="query.phone != null and query.phone.trim() != ''">
            and t.`phone` = #{query.phone}
        </if>
        <if test="query.state != null">
            and t.`state` = #{query.state}
        </if>
        <if test="query.stateOver != null">
            and t.`state` &gt; #{query.stateOver}
        </if>
        <if test="query.roleList != null and query.roleList.size() > 0">
            and
            <foreach collection="query.roleList" item="item" separator=" or " close=")" open="(">
                role_id_list like CONCAT('%', #{item},'%')
            </foreach>
        </if>
        <if test="query.userAccount != null and query.userAccount.trim() != '' ">
            and t.`user_account` = #{query.userAccount}
        </if>
    </sql>

    <!-- BizCountMap 合计, 与 biz-goods SpuDAO.countByCondition 同模式 -->
    <select id="countByCondition" resultType="java.util.Map">
        select
        ${query.fieldSQL}
        from account t
        <where>
            ${ew.sqlSegment}
        </where>
        ${query.groupSQL}
        ${query.sortSQL}
    </select>

    <select id="accountByPidAndUserName" resultType="com.newzkl.platform.base.biz.account.infrastructure.entity.AccountDO">
        select
        t.*
        from account t
        where t.pid = #{pid,jdbcType=BIGINT} and t.username = #{username,jdbcType=VARCHAR}
        and t.del_flag = 0
    </select>

    <select id="groupCount" resultType="com.newzkl.platform.base.common.ddd.model.res.GroupCountRes">
        select
        <if test="query.groupType == 0">
            DATE_FORMAT(create_time, '%Y-%m-%d-%h') as transDay,
        </if>
        <if test="query.groupType == 1">
            DATE_FORMAT(create_time, '%Y-%m-%d') as transDay,
        </if>
        count(*) as transNum
        from account
        where UNIX_TIMESTAMP(create_time) * 1000 between #{query.createBeginTime} and #{query.createEndTime}
        and del_flag = 0
        group by transDay
        order by transDay asc;
    </select>

    <!-- state = 1 即 AccountEnum.State.ENABLE, 与源侧语义一致 -->
    <select id="simpleAccountPage" resultType="com.newzkl.platform.base.biz.account.model.res.SimpleAccountRes">
        select id, username, real_name from account
        <where>
            <if test="query.role != null">
                and `role_id_list`  like CONCAT('%',#{query.role},'%')
            </if>
            <if test="query.username != null and query.username != ''">
                and `username`  like CONCAT('%',#{query.username},'%')
            </if>
            <if test="query.idList != null and query.idList.size() > 0">
                and `id` in
                <foreach collection="query.idList" item="item" separator="," close=")" open="(">
                    #{item}
                </foreach>
            </if>
            and state = 1
            and del_flag = 0
        </where>
    </select>

    <!-- Base 签名由 query 收敛为 accountId, 取源 findScopeSubAccountStructureById 的派生表写法(查全部下级) -->
    <select id="findScopeSubAccountStructure" resultType="com.newzkl.platform.base.biz.account.model.vo.AccountStructureVO">
        select t.id, t.pid, t.pid_list, t.role_id_list, t.create_time,
        IF(t.pid = p.id, 0, 1) as scope
        from account t
        inner join (select id, pid_list from account where id = #{accountId,jdbcType=BIGINT} and del_flag = 0) p on
        t.pid_list like CONCAT(ifnull(p.pid_list,''),p.id,'%')
        where t.del_flag = 0
    </select>

    <select id="selectAwardList" resultType="com.newzkl.platform.base.biz.account.model.vo.AccountAwardUserVO">
        select id, username, nickname, real_name, role_id_list from account
        ${ew.customSqlSegment}
    </select>

    <select id="selectAwardListByIdList" resultType="com.newzkl.platform.base.biz.account.model.vo.AccountRPCResVO">
        select id, real_name, nickname, username, role_id_list, phone, head from account
        ${ew.customSqlSegment}
    </select>

    <select id="selectSonIdList" resultType="java.lang.Long">
        select id from account where pid_list like concat(#{id,jdbcType=BIGINT},'%')
        and del_flag = 0
    </select>

    <select id="selectByUserAccount" resultType="com.newzkl.platform.base.biz.account.infrastructure.entity.AccountDO">
        select
        t.*
        from account t
        where t.user_account = #{userAccount,jdbcType=VARCHAR}
        and t.del_flag = 0
    </select>

    <select id="pageAccountDO" resultType="com.newzkl.platform.base.biz.account.infrastructure.entity.AccountDO">
        select
        t.*
        from account t
        <where>
            t.del_flag = 0
            <include refid="pageWhere"></include>
        </where>
        ${query.sortSQL}
    </select>

    <select id="countAccountDO" resultType="java.lang.Long">
        select count(1)
        from account t
        <where>
            t.del_flag = 0
            <include refid="pageWhere"></include>
        </where>
    </select>

    <select id="listAccountByIds" resultType="com.newzkl.platform.base.biz.account.model.vo.AccountVO">
        select
        t.*
        from account t
        <where>
            t.del_flag = 0
            <if test="ids != null and ids.size() > 0">
                and t.id in
                <foreach collection="ids" item="id" separator="," open="(" close=")">
                    #{id,jdbcType=BIGINT}
                </foreach>
            </if>
        </where>
    </select>

</mapper>
