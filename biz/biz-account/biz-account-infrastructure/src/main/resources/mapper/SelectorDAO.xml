<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 迁移自 new-scm/scm-user SelectorDAO.xml
     适配: Base selector 表已无 invite_id/username/state 列(收敛 account 表), 改 join account 取 -->
<mapper namespace="com.newzkl.platform.base.biz.account.infrastructure.dao.SelectorDAO">

    <select id="selectCountByCondition" resultType="java.lang.Long">
        select
        count(1)
        from selector
        <where>
            ${ew.sqlSegment}
        </where>
    </select>

    <select id="selectListByCondition" resultType="java.lang.Long">
        select
        id
        from selector
        <where>
            ${ew.sqlSegment}
        </where>
    </select>

    <!-- Base 返回 SelectorOutRes, teamCount/yesterdayInvite 等统计列 Base 已无, 对应字段落 null -->
    <select id="selectList" resultType="com.newzkl.platform.base.biz.account.model.res.SelectorOutRes">
        select
        *
        from selector
        ${ew.customSqlSegment}
    </select>

    <!-- 源取 selector.invite_id, Base 该列已收敛 account.invite_account_id -->
    <select id="inviteIdByQuery" resultType="java.lang.Long">
        select
        a.invite_account_id
        from selector t
        left join account a on t.id = a.id
        where t.id = #{accountId,jdbcType=BIGINT} and t.del_flag = 0
    </select>

    <!-- 源按 selector.username + state 过滤, Base 两列均在 account 表 -->
    <select id="selectorIdByUsername" resultType="java.lang.Long">
        select t.id from selector t
        left join account a on t.id = a.id
        where a.username = #{username,jdbcType=VARCHAR} and a.state &gt;= 0
        and t.del_flag = 0 and a.del_flag = 0
    </select>

</mapper>
