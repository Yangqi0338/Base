<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.base.biz.activity.infrastructure.dao.ActivityOtherConfigDAO">

  <select id="otherConfig" resultType="com.newzkl.platform.base.biz.activity.model.event.vo.ActivityOtherConfigVO">
    select config_details as configDetails,show_config as showConfig
    from activity_other_config
    where id = #{otherConfigId}
    and channel_id = #{channelId}
  </select>
</mapper>
