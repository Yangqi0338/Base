<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.newzkl.platform.Base</groupId>
        <artifactId>biz-finance</artifactId>
        <version>${revision}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>biz-finance-domain</artifactId>
    <packaging>jar</packaging>
    <name>biz-finance-domain</name>
    <dependencies>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>biz-finance-model</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>biz-finance-facade</artifactId>
        </dependency>
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>ddd-domain</artifactId>
        </dependency>
        <!-- 迁移补充: domain 使用 core-utils(TransferUtils/BizUtil/generator/JSON) -->
        <dependency>
            <groupId>com.newzkl.platform.Base</groupId>
            <artifactId>core-utils</artifactId>
        </dependency>
        <!-- 迁移补充: hf/ 汇付三方接口走 forest (HuiFuApi @ForestClient) -->
        <dependency>
            <groupId>com.dtflys.forest</groupId>
            <artifactId>forest-spring-boot3-starter</artifactId>
        </dependency>
        <!-- 迁移补充: EarningStrategySupport 使用 @Resource/@PostConstruct (jakarta.annotation) -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>2.1.1</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <!-- 迁移补充: Mockito(ByteBuddy) 在本 JDK 需显式允许自挂载 agent, 否则 mock 初始化失败 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
