        <module>biz-auth</module>
        <module>biz-user</module>
        <module>biz-sys</module>
        <module>biz-finance</module>
        <module>biz-order</module>
        <module>biz-goods</module>
        <module>biz-market</module>
        <module>biz-content</module>
        <module>biz-course</module>
        <module>biz-store</module>
        <module>biz-social-bang</module>
