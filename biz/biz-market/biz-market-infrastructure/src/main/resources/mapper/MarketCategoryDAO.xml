<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.base.biz.market.infrastructure.dao.MarketCategoryDAO">

    <!-- 市场商品分类两级嵌套映射 (迁移自 new-scm MarketCategoryDAO.xml 的 MarketGoodsCategoryResultMap) -->
    <resultMap id="MarketGoodsCategoryResultMap"
               type="com.newzkl.platform.base.biz.market.model.vo.market.MarketGoodsCategoryVO">
        <result column="id" jdbcType="BIGINT" property="id"/>
        <result column="name" jdbcType="VARCHAR" property="name"/>
        <result column="img" jdbcType="VARCHAR" property="img"/>
        <collection property="twoCategory"
                    ofType="com.newzkl.platform.base.biz.market.model.vo.market.MarketGoodsCategoryVO">
            <result column="twoId" jdbcType="BIGINT" property="id"/>
            <result column="twoName" jdbcType="VARCHAR" property="name"/>
            <result column="twoImg" jdbcType="VARCHAR" property="img"/>
        </collection>
    </resultMap>

    <!-- 查询市场商品分类 (迁移自 new-scm MarketCategoryDAO.xml 的 queryMarketGoodsCategory) -->
    <!-- 源侧 marketId / userId 各自带 where 前缀, 两者互斥使用, 此处逐字保留 -->
    <select id="queryMarketGoodsCategory" resultMap="MarketGoodsCategoryResultMap">
        select c2.id,c2.name,c2.img,c1.id as twoId,c1.name as twoName,c1.img as twoImg
        from market_goods_relation mgr
        left join spu sp on mgr.goods_id = sp.id
        left join spu_category c1 on sp.category_id = c1.id
        left join spu_category c2 on c1.pid = c2.id
        <if test="marketId != null">
            where mgr.market_id = #{marketId}
            and mgr.relation_type = 2
        </if>
        <if test="userId != null">
            where mgr.user_id = #{userId}
            and relation_type = 3
        </if>
    </select>

</mapper>
