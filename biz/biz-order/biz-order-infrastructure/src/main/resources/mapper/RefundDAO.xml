<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 迁移自 new-scm/scm-sale RefundDAO.xml
     适配: order_id -> order_no, spu_order_id -> spu_order_no;
           toState/sourceState 为 RefundEnum.State 枚举(@EnumValue code), CONCAT 里的 ${toState} 改 #{toState}
           (枚举 toString 落库会写成枚举名而非数字, 原样照抄必错) -->
<mapper namespace="com.newzkl.platform.base.biz.order.infrastructure.dao.refund.RefundDAO">

    <select id="getOutRefundAddress" resultType="java.lang.String">
        select t.out_refund_address
        from refund t
        left join spu_order t1 on t.spu_order_no = t1.spu_order_no
        where
          t.`spu_order_no` = #{spuOrderNo,jdbcType=VARCHAR}
          and t1.spu_id = #{spuId}
          and t.refund_state in (0,1,2,4)
          and t.del_flag = 0
    </select>



</mapper>
