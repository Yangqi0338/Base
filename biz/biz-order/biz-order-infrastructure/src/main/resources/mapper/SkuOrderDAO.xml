<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.base.biz.order.infrastructure.dao.order.SkuOrderDAO">
    <update id="updateSkuDeliverCount">
        update sku_order
        <set>
            `deliver_count` = `deliver_count` + #{count}
        </set>
        where `spu_order_id` = #{spuOrderId}
        and `sku_id` = #{skuId}
        and `count` &gt;= `deliver_count` + #{count}
    </update>
    <select id="skuRefundResList" resultType="com.newzkl.platform.base.biz.order.model.dto.SkuRefundDTO">
        select
            t.sku_id,
            t.spu_id,
            t.count as order_count,
            t.id as  sku_order_id,
            t.spu_order_id,
            t.refunding_count,
            t.refunded_count,
            t.delivery_count,
            t.order_state as sku_order_state,
            t1.`spu_name` ,
            t1.`spu_img` ,
            t1.supplier_id
        from sku_order t left join spu_order t1 on t.spu_order_id = t1.id
        ${ew.customSqlSegment}
    </select>

    <update id="updateSkuRefundingCount">
        update sku_order
        <set>
            `refunding_count` = `refunding_count` + #{count}
        </set>
        where `order_id` = #{orderId}
        and `sku_id` = #{skuId}
        and `count` &gt;= `refunding_count` + #{count} + `refunded_count`
    </update>

    <!-- MySQL SET 从左到右求值, order_state 的 if 用的是更新后的 refunded_count, 与源侧一致 -->
    <update id="skuOrderEditForRefundPass">
        update sku_order t set
            t.refunded_count = t.refunded_count + t.refunding_count,
            t.refunding_count = 0,
            t.order_state = if(t.refunded_count + t.refunding_count = t.buy_num, #{toState}, t.order_state)
        where
            t.`id` in
        <foreach collection="skuOrderId" item="item" separator="," close=")" open="(">
            #{item,jdbcType=VARCHAR}
        </foreach>
    </update>

</mapper>
