<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.base.biz.goods.infrastructure.goods.dao.SpuCategoryDAO">

    <!-- 列表查询条件 (迁移自 new-scm CategoryDAO.xml 的 where)
         源 category 表在 Base 改名为 spu_category (SpuCategoryDO @TableName 推导)
         已删条件: idWithChild / idOrPid / accountIdOrAdmin (Base SpuCategoryQuery 无对应字段)
         已删条件: query.id (Base 侧 getId() 取 idList 首项, 与 idList 条件重复且会缩小结果集)
         已删条件: brandName (Base spu_category 无 brand_name_list 列, 字段虽在 Query 上但无列可查, 见 findings)
         新增条件: accountIdList (Base BizPageQuery 提供, 替代源 accountIdOrAdmin 的语义位置) -->
    <sql id="querySQL">
        <if test="query.idList != null and query.idList.size() > 0">
            and t.id in
            <foreach collection="query.idList" item="item" separator="," close=")" open="(">
                #{item}
            </foreach>
        </if>
        <if test="query.pidList != null and query.pidList.size() > 0">
            and t.pid in
            <foreach collection="query.pidList" item="item" separator="," close=")" open="(">
                #{item}
            </foreach>
        </if>
        <if test="query.pid != null">
            and t.`pid` = #{query.pid}
        </if>
        <if test="query.name != null and query.name != ''">
            and t.`name` like CONCAT('%',#{query.name},'%')
        </if>
        <if test="query.notId != null">
            and t.`id` &lt;&gt; #{query.notId}
        </if>
        <if test="query.accountIdList != null and query.accountIdList.size() > 0">
            and t.account_id in
            <foreach collection="query.accountIdList" item="item" separator="," close=")" open="(">
                #{item}
            </foreach>
        </if>
    </sql>

    <!-- 分类计数 (迁移自 new-scm CategoryDAO.xml 的 categoryCount) -->
    <select id="categoryCount" resultType="java.lang.Integer">
        select
        count(t.id)
        from spu_category t
        <where>
            and t.del_flag = 0
            <include refid="querySQL"/>
        </where>
    </select>

    <!-- 分类分页 (迁移自 new-scm CategoryDAO.xml 的 listByQuery; 分页壳由 PageInfo 改为 MyBatis-Plus Page
         恢复列: brand_id_list (源 category 表有, Base 建表曾删, 本轮 bindBrand 端点补迁时恢复)
         仍删列: brand_name_list (品牌名冗余存储, 前端未用, 不恢复)
         新增列: idx / is_enabled / pid_list / level (Base CategoryLayerDO 新增字段) -->
    <select id="listByQuery" resultType="com.newzkl.platform.base.biz.goods.model.goods.vo.brand.SpuCategoryVO">
        select
        t.`id`,t.`account_id`,t.`name`,t.`desc`,t.`img`,t.`idx`,t.`is_enabled`,t.`pid`,t.`pid_list`,t.`level`,t.`brand_id_list`,t.`create_time`,t.`update_time`
        from spu_category t
        <where>
            and t.del_flag = 0
            <include refid="querySQL"/>
        </where>
    </select>

</mapper>
