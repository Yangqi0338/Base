<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.newzkl.platform.base.biz.goods.infrastructure.goods.dao.BrandDAO">

    <!-- 列表查询条件 (迁移自 new-scm IUserQueryService.xml 的 where; 该文件名与内容不符, namespace 实为 BrandDAO) -->
    <sql id="querySQL">
        <if test="query.id != null">
            and t.`id` = #{query.id}
        </if>
        <if test="query.idList != null and query.idList.size() > 0">
            and t.id in
            <foreach collection="query.idList" item="item" separator="," close=")" open="(">
                #{item}
            </foreach>
        </if>
        <if test="query.name != null and query.name != ''">
            and t.`name`  like CONCAT('%',#{query.name},'%')
        </if>
    </sql>

    <!-- 品牌分页 (迁移自 new-scm IUserQueryService.xml 的 listByQuery; 分页壳由 PageInfo 改为 MyBatis-Plus Page) -->
    <select id="queryPage" resultType="com.newzkl.platform.base.biz.goods.model.goods.vo.brand.BrandVO">
        select
        t.`id`,t.`account_id`,t.`name`,t.`logo`,t.`create_time`,t.`update_time`
        from brand t
        <where>
            and t.del_flag = 0
            <include refid="querySQL"/>
        </where>
    </select>

</mapper>
